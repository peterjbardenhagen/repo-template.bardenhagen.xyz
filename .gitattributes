# Auto-detect text files
* text=auto

# Normalise line endings for source files
*.cs text eol=lf
*.js text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.jsx text eol=lf
*.json text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.css text eol=lf
*.html text eol=lf
*.sh text eol=lf
*.ps1 text eol=lf
*.py text eol=lf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.eot binary
*.ttf binary
*.pdf binary
*.zip binary
*.tar binary
*.gz binary

# GitHub specific
.gitattributes text eol=lf
.gitignore text eol=lf

# Linguist overrides
*.md linguist-detectable=true

# Additional source and configuration formats
*.jsonc text eol=lf
*.mdx text eol=lf
*.mjs text eol=lf
*.cjs text eol=lf
*.psm1 text eol=lf
*.psd1 text eol=lf
*.sql text eol=lf
*.xml text eol=lf
*.toml text eol=lf
*.csproj text eol=lf
*.sln text eol=lf
*.props text eol=lf
*.targets text eol=lf
*.razor text eol=lf
*.cshtml text eol=lf
*.graphql text eol=lf
*.gql text eol=lf

# Windows command scripts
*.bat text eol=crlf
*.cmd text eol=crlf

# SVG is text, not a binary image
*.svg text eol=lf diff merge

# Additional binary formats
*.webp binary
*.bmp binary
*.tif binary
*.tiff binary
*.mp3 binary
*.mp4 binary
*.mov binary
*.webm binary
*.wav binary
*.avi binary
*.exe binary
*.dll binary
*.so binary
*.dylib binary
*.bin binary
*.db binary
*.sqlite binary
*.sqlite3 binary
*.psd binary
*.ai binary
*.sketch binary
*.fig binary

