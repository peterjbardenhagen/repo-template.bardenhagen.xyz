{
  "$schema": "https://opencode.ai/config.json",
  "model": "9router/oc/deepseek-v4-flash-free",
  "agent": {
    "explorer": {
      "description": "Fast explorer subagent for codebase exploration",
      "mode": "subagent",
      "model": "9router/oc/deepseek-v4-flash-free"
    },
    "architect": {
      "description": "System design, ADRs, tech decisions",
      "mode": "subagent",
      "model": "9router/kr/claude-sonnet-4.5"
    },
    "coder": {
      "description": "Feature implementation, refactoring",
      "mode": "subagent",
      "model": "9router/kr/claude-sonnet-4.5"
    },
    "reviewer": {
      "description": "Code review, quality gates",
      "mode": "subagent",
      "model": "9router/kr/claude-haiku-4.5"
    },
    "tester": {
      "description": "Test strategy, test automation",
      "mode": "subagent",
      "model": "9router/kr/claude-haiku-4.5"
    },
    "devops": {
      "description": "CI/CD, infrastructure, deployment",
      "mode": "subagent",
      "model": "9router/kr/claude-sonnet-4.5"
    }
  }
}
